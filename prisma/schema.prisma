datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  role          Role       @default(USER)
  plan          Plan       @default(FREE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  analyses      Analysis[]
  feedback      Feedback[]

  @@map("users")
}

model Analysis {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  category        String   @default("Educational / How-To")
  scriptContent   String   @db.Text
  viralScore      Int
  hooks           String   @db.Text
  titles          String   @db.Text
  retentionAlerts String   @db.Text
  seoDescription  String   @db.Text
  isFavorite      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("analyses")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  text      String   @db.Text
  rating    Int      @default(5)
  status    String   @default("Open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("feedback")
}